#!/bin/sh
set -eu
PACKAGE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${OPENCUT_BUN:-}" ]; then
  exec "$OPENCUT_BUN" run "$@"
fi
if [ -x "$PACKAGE_ROOT/node_modules/.bin/bun" ]; then
  exec "$PACKAGE_ROOT/node_modules/.bin/bun" run "$@"
fi
if command -v bun >/dev/null 2>&1; then
  exec bun run "$@"
fi
echo "Install this checkout's dependencies first (Bun 1.3.11 is pinned in .prototools)." >&2
exit 1
