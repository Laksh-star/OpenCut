{
  "name": "@opencut/agent-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "opencut-agent": "./bin/opencut-agent"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:render": "bun run scripts/render-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2"
  }
}
